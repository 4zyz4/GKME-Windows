<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeBuildOutputsInDotNetSelfContained>true</IncludeNativeBuildOutputsInDotNetSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyVersion>3.1.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="icon.ico" />
    <Content Include="profiles\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>profiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="proto\gamepad_state.proto">
      <ProtoRoot>proto</ProtoRoot>
    </Protobuf>
  </ItemGroup>

  <!-- Driver source files are automatically included by SDK -->

  <!-- Build InputDll C++ project before C# compile -->
  <Target Name="BuildInputDll" BeforeTargets="BeforeBuild">
    <Message Text="Building InputDll..." Importance="high" />
    <Exec Command="&quot;C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe&quot; &quot;$(ProjectDir)Driver\InputDll\InputDll.vcxproj&quot; /p:Configuration=$(Configuration) /p:Platform=x64 /t:Build /nologo /v:normal" />
  </Target>

  <!-- Copy InputDll.dll to output directory -->
  <ItemGroup Condition="Exists('bin\$(Configuration)\InputDll.dll')">
    <Content Include="bin\$(Configuration)\InputDll.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>InputDll.dll</Link>
    </Content>
  </ItemGroup>

  <!-- Embedded resources: USBip installer + license notices -->
  <ItemGroup>
    <EmbeddedResource Include="Driver\Resources\USBip-0.9.7.7-x64.exe">
      <LogicalName>HIDMaestro.Resources.USBip-0.9.7.7-x64.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Driver\Resources\THIRD-PARTY-NOTICES.txt">
      <LogicalName>HIDMaestro.Resources.THIRD-PARTY-NOTICES.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Profile catalog as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="profiles\**\*.json" Exclude="profiles\schema.json;profiles\scraped_descriptors.json;profiles\linux-kernel-fixed-descriptors.json">
      <LogicalName>HIDMaestro.Profiles.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>