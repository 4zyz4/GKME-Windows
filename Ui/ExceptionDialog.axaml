<Window x:Class="GKME.Ui.ExceptionDialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Exception_Title}"
        Width="600" Height="450"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        CanResize="True">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#1177BB"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Styles>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Exception_Heading}" 
                   FontSize="14" FontWeight="SemiBold" Foreground="#F48761"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <TextBox x:Name="ErrorText" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="#252525" Padding="14" CornerRadius="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Exception_CopyAll}" Width="140" Margin="0,0,10,0" Click="OnCopyAll"
                        ToolTip.Tip="{DynamicResource Exception_CopyAllTip}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{DynamicResource Exception_CloseExits}" 
                   FontSize="11" Foreground="#888888" TextAlignment="Center"/>
    </Grid>
</Window>