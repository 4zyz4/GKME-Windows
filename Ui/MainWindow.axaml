<Window x:Class="GKME.Ui.MainWindow" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GKME.Ui"
        Width="580" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
    <Window.Styles>
        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Menu > MenuItem">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="BorderBrush" Value="#3E3E3E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="Button.mode">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.action:pointerover">
            <Setter Property="Background" Value="#1177BB" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C23B22" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#E0553A" />
        </Style>

        <Style Selector="TextBox.input">
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ComboBox.dark">
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ComboBox.dark /template/ ComboBoxItem">
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ComboBox.dark /template/ ComboBoxItem:pointerover:item">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Menu Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,10">
            <MenuItem Header="{DynamicResource Menu_Connection}">
                <MenuItem Header="{DynamicResource Menu_ManualConnect}" Click="OnMenuManualConnectClick" />
                <MenuItem Header="{DynamicResource Menu_Refresh}" Click="OnMenuRefreshClick" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_DisconnectAll}" Click="OnMenuDisconnectAllClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu_Language}">
                <MenuItem x:Name="FollowSystemItem" Header="{DynamicResource Lang_FollowSystem}"
                          ToggleType="Radio" GroupName="Language" Tag="FollowSystem"
                          Click="OnLanguageMenuClick" />
                <MenuItem x:Name="EnglishItem" Header="{DynamicResource Lang_English}"
                          ToggleType="Radio" GroupName="Language" Tag="English"
                          Click="OnLanguageMenuClick" />
                <MenuItem x:Name="SimplifiedChineseItem" Header="{DynamicResource Lang_SimplifiedChinese}"
                          ToggleType="Radio" GroupName="Language" Tag="SimplifiedChinese"
                          Click="OnLanguageMenuClick" />
                <MenuItem x:Name="TraditionalChineseHongKongItem" Header="{DynamicResource Lang_TraditionalChineseHongKong}"
                          ToggleType="Radio" GroupName="Language" Tag="TraditionalChineseHongKong"
                          Click="OnLanguageMenuClick" />
                <MenuItem x:Name="TraditionalChineseTaiwanItem" Header="{DynamicResource Lang_TraditionalChineseTaiwan}"
                          ToggleType="Radio" GroupName="Language" Tag="TraditionalChineseTaiwan"
                          Click="OnLanguageMenuClick" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu_About}" Click="OnAboutClick" />
        </Menu>

        <!-- Manual IP input -->
        <Border Grid.Row="1" Classes="card" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource IpAddress}" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding ManualIp, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Height="30" FontSize="13"
                         Classes="input" />
                <Button Grid.Column="2" Content="{DynamicResource ManualConnect}" Width="80" Height="30" Margin="8,0,0,0"
                        Classes="action"
                        Click="OnManualConnectClick" />
                <Button Grid.Column="3" Content="{DynamicResource Refresh}" Width="60" Height="30" Margin="8,0,0,0"
                        Classes="action"
                        Click="OnRefreshClick" />
            </Grid>
        </Border>

        <!-- Web controller card: NIC selection, current address and QR code -->
        <Border Grid.Row="2" Classes="card" IsVisible="{Binding HasWebUrl}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource WebController}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource SelectInterface}" FontSize="11" Foreground="#9D9D9D" Margin="0,8,0,2" />
                    <ComboBox Width="240" Height="28" FontSize="12" VerticalContentAlignment="Center"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding WebInterfaces}"
                              SelectedItem="{Binding SelectedWebInterface}"
                              Classes="dark">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="#E0E0E0" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding WebHost}" FontSize="13" FontFamily="Consolas" Margin="0,8,0,0" />
                </StackPanel>

                <Image Grid.Column="1" Source="{Binding WebQrCode}" Width="120" Height="120"
                       Margin="14,0,0,0" VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="None" />
            </Grid>
        </Border>

        <!-- Device card list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DeviceCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <!-- Expanded: same MAC reachable over several IPs and none
                             connected. Each IP gets its own connect button. -->
                        <Border Classes="card" IsVisible="{Binding IsExpanded}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#9D9D9D" Margin="0,2,0,0"
                                           IsVisible="{Binding HasSubtitle}" />

                                <ItemsControl ItemsSource="{Binding Endpoints}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IpAddress}" FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="{DynamicResource Connect}" Width="70" Height="28"
                                                        Classes="action"
                                                        IsVisible="{Binding ShowConnect}"
                                                        Click="OnEndpointConnectClick" />
                                                <Button Grid.Column="1" Content="{DynamicResource Connecting}" Width="70" Height="28"
                                                        Classes="action"
                                                        IsVisible="{Binding IsConnecting}" />
                                                <Button Grid.Column="1" Content="{DynamicResource Disconnect}" Width="70" Height="28"
                                                        Classes="danger"
                                                        IsVisible="{Binding ShowReconnecting}"
                                                        Click="OnEndpointDisconnectClick" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Collapsed (original layout): a single IP, or one already in use. -->
                        <Border Classes="card" IsVisible="{Binding IsCollapsed}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ActiveIpAddress}" FontSize="11" Foreground="#9D9D9D" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#9D9D9D" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Connect button -->
                                <Button Grid.Column="1" Content="{DynamicResource Connect}" Width="70" Height="30"
                                        Classes="action"
                                        IsVisible="{Binding ShowConnect}"
                                        Click="OnCardConnectClick" />

                                <!-- Reconnecting indicator -->
                                <Button Grid.Column="1" Content="{DynamicResource Disconnect}" Width="50" Height="30"
                                        Classes="danger"
                                        IsVisible="{Binding ShowReconnecting}"
                                        Click="OnCardDisconnectClick" />

                                <!-- Session controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            IsVisible="{Binding ShowControls}">
                                    <ComboBox Width="140" Height="28" FontSize="12" VerticalContentAlignment="Center"
                                              ItemsSource="{x:Static ui:DeviceCardViewModel.AllModes}"
                                              SelectedItem="{Binding SelectedMode}"
                                              SelectionChanged="OnModeChanged"
                                              Classes="dark">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"
                                                           Foreground="#E0E0E0" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="{DynamicResource Disconnect}" Width="50" Height="28" Margin="6,0,0,0"
                                            Classes="danger"
                                            Click="OnCardDisconnectClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Spacer for footer space -->
        <Border Grid.Row="4" />
    </Grid>
</Window>
