<Window x:Class="GKME.Ui.SponsorDialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About_Sponsor}"
        Width="340"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="24" Spacing="16">
        <TextBlock FontSize="14" Foreground="#9D9D9D" HorizontalAlignment="Center"
                   Text="{DynamicResource About_SponsorThanks}" />
        <Image Source="/Assets/reward.png" Width="180" Height="180" Stretch="Uniform"
               HorizontalAlignment="Center" />
        <Button Content="{DynamicResource Close}" HorizontalAlignment="Center" Click="OnCloseClick" />
    </StackPanel>
</Window>
