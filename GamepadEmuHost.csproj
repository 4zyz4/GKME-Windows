<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <StartupObject>GamepadEmuHost.App</StartupObject>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyVersion>3.1.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="profiles\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>profiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="proto\gamepad_state.proto">
      <ProtoRoot>proto</ProtoRoot>
    </Protobuf>
  </ItemGroup>

  <!-- Driver source files are automatically included by SDK -->

  <!-- Build KeyboardDll C++ project before C# compile -->
  <Target Name="BuildKeyboardDll" BeforeTargets="BeforeBuild">
    <Message Text="Building KeyboardDll..." Importance="high" />
    <Exec Command="&quot;C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe&quot; &quot;$(ProjectDir)Driver\KeyboardDll\KeyboardDll.vcxproj&quot; /p:Configuration=$(Configuration) /p:Platform=x64 /t:Build /nologo /v:normal" />
  </Target>

  <!-- Copy KeyboardDll.dll to output directory -->
  <ItemGroup Condition="Exists('Driver\KeyboardDll\bin\$(Configuration)\KeyboardDll.dll')">
    <Content Include="Driver\KeyboardDll\bin\$(Configuration)\KeyboardDll.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>KeyboardDll.dll</Link>
    </Content>
  </ItemGroup>

  <!-- Embedded resources: USBip installer + license notices -->
  <ItemGroup>
    <EmbeddedResource Include="Driver\Resources\USBip-0.9.7.7-x64.exe">
      <LogicalName>HIDMaestro.Resources.USBip-0.9.7.7-x64.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Driver\Resources\THIRD-PARTY-NOTICES.txt">
      <LogicalName>HIDMaestro.Resources.THIRD-PARTY-NOTICES.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Profile catalog as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="..\profiles\**\*.json"
                      Exclude="..\profiles\schema.json;..\profiles\scraped_descriptors.json;..\profiles\linux-kernel-fixed-descriptors.json">
      <LogicalName>HIDMaestro.Profiles.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <Link>Profiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>