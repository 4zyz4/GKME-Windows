<Window x:Class="GKME.Ui.AboutDialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About_Title}"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
    <Window.Styles>
        <Style Selector="TextBlock.link">
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Foreground" Value="#0E639C" />
        </Style>
        <Style Selector="TextBlock.link:pointerover">
            <Setter Property="Foreground" Value="#1177BB" />
        </Style>
    </Window.Styles>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Icon + Title -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,20">
            <Image Source="/icon.png" Width="48" Height="48" Margin="0,0,16,0" />
            <StackPanel Orientation="Vertical">
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#E0E0E0"
                           VerticalAlignment="Center" Text="GKME" />
                <TextBlock x:Name="VersionTextBlock" FontSize="12" Foreground="#888888"
                           VerticalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Info text -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="3" Margin="0,0,0,16">
            <TextBlock FontSize="12" Foreground="#888888" TextAlignment="Center"
                       Text="{DynamicResource About_Author}" />
            <TextBlock FontSize="12" Foreground="#888888" TextAlignment="Center"
                       Text="{DynamicResource About_QQGroup}" />
            <TextBlock FontSize="12" Foreground="#888888" TextAlignment="Center" Margin="0,8,0,0"
                       Text="{DynamicResource About_OpenSource}" />
            <TextBlock Classes="link" FontSize="12" Text="https://github.com/4zyz4/GKME"
                       HorizontalAlignment="Center" />
            <TextBlock FontSize="12" Foreground="#888888" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="340" Margin="0,12,0,0"
                       Text="{DynamicResource About_Note}" />
        </StackPanel>
    </Grid>
</Window>
