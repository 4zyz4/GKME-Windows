<Project Sdk="Microsoft.NET.Sdk">

  <!-- GKME ships as a self-contained NativeAOT executable per platform:
       Windows x64 / ARM64 and Linux x64 / ARM64. The target framework, the
       output type and every Windows-only build input are derived from the
       runtime identifier, so one project file builds all four. Pass
       -r <rid> to cross-select a platform; without it the machine's own RID
       is used (win-x64, win-arm64, linux-x64 or linux-arm64). -->
  <PropertyGroup>
    <GkmeRuntimeIdentifier Condition="'$(GkmeRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</GkmeRuntimeIdentifier>
    <GkmeRuntimeIdentifier Condition="'$(GkmeRuntimeIdentifier)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</GkmeRuntimeIdentifier>
    <GkmeIsWindows Condition="$(GkmeRuntimeIdentifier.StartsWith('win'))">true</GkmeIsWindows>
    <GkmeIsWindows Condition="'$(GkmeIsWindows)' == ''">false</GkmeIsWindows>

    <!-- net10.0-windows on Windows (Win32 interop, registry, setupapi), the
         plain net10.0 TFM on Linux (same GKMD sources, vhci_hcd backend). -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(GkmeIsWindows)' == 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(GkmeRuntimeIdentifier)</RuntimeIdentifier>

    <OutputType Condition="'$(GkmeIsWindows)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(GkmeIsWindows)' != 'true'">Exe</OutputType>

    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaEnableDependInfo>true</AvaloniaEnableDependInfo>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeBuildOutputsInDotNetSelfContained>true</IncludeNativeBuildOutputsInDotNetSelfContained>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerRootDescriptor>linker.xml</TrimmerRootDescriptor>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <IlcOptimize>true</IlcOptimize>
    <IlcFoldIdenticalBehavior>true</IlcFoldIdenticalBehavior>
    <StripSymbols>true</StripSymbols>
    <Version>4.8.0.0</Version>
    <VersionString>$(Version)</VersionString>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IlcInvariantGlobalization>true</IlcInvariantGlobalization>
    <DebugType>full</DebugType>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2070;IL2075;IL3000</NoWarn>
  </PropertyGroup>

  <!-- Windows-only build inputs: the exe icon, the manifest that requests
       administrator (needed to attach usbip-win2 devices) and the generated
       manifest itself. None of these exist in a Linux build. -->
  <PropertyGroup Condition="'$(GkmeIsWindows)' == 'true'">
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Only the two supported desktop families can be built: the virtual
       controller backend exists for usbip-win2 (Windows) and vhci_hcd (Linux).
       Fail a macOS/unknown RID with a readable message instead of a Linux TFM
       that would compile but never attach a device. -->
  <Target Name="ValidateGkmePlatform" BeforeTargets="BeforeBuild">
    <Error Condition="!$(GkmeRuntimeIdentifier.StartsWith('win')) and !$(GkmeRuntimeIdentifier.StartsWith('linux'))"
           Text="GKME supports win-x64, win-arm64, linux-x64 and linux-arm64 only (got '$(GkmeRuntimeIdentifier)')." />
  </Target>

  <!-- 用 $(Version) 动态生成 app.manifest -->
  <Target Name="GenerateAppManifest" BeforeTargets="BeforeBuild"
          Condition="'$(GkmeIsWindows)' == 'true'">
    <PropertyGroup>
      <_ManifestContent>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&#10;&lt;assembly manifestVersion=&quot;1.0&quot; xmlns=&quot;urn:schemas-microsoft-com:asm.v1&quot;&gt;&#10;  &lt;assemblyIdentity version=&quot;$(Version)&quot; name=&quot;GKME&quot;/&gt;&#10;  &lt;trustInfo xmlns=&quot;urn:schemas-microsoft-com:asm.v2&quot;&gt;&#10;    &lt;security&gt;&#10;      &lt;requestedPrivileges&gt;&#10;        &lt;requestedExecutionLevel level=&quot;requireAdministrator&quot; uiAccess=&quot;false&quot;/&gt;&#10;      &lt;/requestedPrivileges&gt;&#10;    &lt;/security&gt;&#10;  &lt;/trustInfo&gt;&#10;&lt;/assembly&gt;</_ManifestContent>
    </PropertyGroup>
    <WriteLinesToFile File="app.manifest" Lines="$(_ManifestContent)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="icon.ico" />
    <AvaloniaResource Include="icon.png" />
    <!-- CJK fallback for Linux only: Windows always ships a CJK system font. -->
    <AvaloniaResource Include="Assets\Fonts\wqy-microhei.ttf" Condition="'$(GkmeIsWindows)' != 'true'" />
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <TrimmerRootDescriptor Include="linker.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="proto\gamepad_state.proto">
      <ProtoRoot>proto</ProtoRoot>
    </Protobuf>
  </ItemGroup>
  <!-- GKMD is compiled from source into this AOT image. Its release
       artifact is a NativeAOT C ABI library (GKMD.dll / libGKMD.so) and
       can no longer be referenced as a managed assembly, so the sources
       and embedded payload are pulled in directly. -->
  <PropertyGroup>
    <UsbipPayloadArch Condition="'$(UsbipPayloadArch)' == '' and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.ToLowerInvariant().Contains('arm64'))">arm64</UsbipPayloadArch>
    <UsbipPayloadArch Condition="'$(UsbipPayloadArch)' == ''">x64</UsbipPayloadArch>
    <!-- GKMD_WINDOWS selects its Win32/registry/usbip-win2 implementation;
         without it the same sources compile the Linux vhci_hcd backend. -->
    <DefineConstants Condition="'$(GkmeIsWindows)' == 'true'">$(DefineConstants);GKMD_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(GkmeIsWindows)' == 'true'">
    <EmbeddedResource Include="..\GKMD\Resources\USBip-0.9.8.1-$(UsbipPayloadArch).exe">
      <LogicalName>GKMD.Resources.USBip-0.9.8.1-$(UsbipPayloadArch).exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\GKMD\**\*.cs"
             Exclude="..\GKMD\bin\**;..\GKMD\obj\**;..\GKMD\tools\**;..\GKMD\Native\**;..\GKMD\AssemblyInfo.cs" />
    <EmbeddedResource Include="..\GKMD\Resources\THIRD-PARTY-NOTICES.txt">
      <LogicalName>GKMD.Resources.THIRD-PARTY-NOTICES.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Ship the licenses of the components bundled with GKME: GKMD's MIT
       license and the third-party notices for the embedded usbip-win2. They
       are copied into the publish folder and installed under `licenses\`. -->
  <ItemGroup>
    <Content Include="..\GKMD\LICENSE">
      <Link>licenses\GKMD-LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\GKMD\Resources\THIRD-PARTY-NOTICES.txt">
      <Link>licenses\USBIP-WIN2-LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Fonts\LICENSE-WQY-MicroHei.txt">
      <Link>licenses\WQY-MICROHEI-LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Bundled adb (USB mode fallback). Put the Android SDK platform-tools
       contents into `platform-tools\` next to this project; they are copied to
       the output/publish folder and shipped by the installer. The build still
       succeeds when absent (an adb on PATH or in the Android SDK is used).
       The directory is the same on every platform; only the executable name
       inside differs (adb.exe / adb). -->  <ItemGroup Condition="Exists('platform-tools')">
    <Content Include="platform-tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- The browser-based controller app (GKME-Web) is bundled into the output
       under `web` and served by the embedded WebServer. It lives in a sibling
       repository directory, so only the site itself may be copied: repository
       metadata (.git/.github/...) and docs must never reach the output or the
       installer. -->
  <ItemGroup Condition="Exists('..\GKME-Web\index.html')">
    <Content Include="..\GKME-Web\**\*"
             Exclude="..\GKME-Web\.git\**;..\GKME-Web\.github\**;..\GKME-Web\.vscode\**;..\GKME-Web\.idea\**;..\GKME-Web\.gitignore;..\GKME-Web\.gitattributes;..\GKME-Web\**\*.md;..\GKME-Web\**\Thumbs.db;..\GKME-Web\**\.DS_Store">
      <Link>web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
