<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaEnableDependInfo>true</AvaloniaEnableDependInfo>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeBuildOutputsInDotNetSelfContained>true</IncludeNativeBuildOutputsInDotNetSelfContained>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerRootDescriptor>linker.xml</TrimmerRootDescriptor>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <IlcOptimize>true</IlcOptimize>
    <IlcFoldIdenticalBehavior>true</IlcFoldIdenticalBehavior>
    <StripSymbols>true</StripSymbols>
    <Version>4.0.0.0</Version>
    <VersionString>$(Version)</VersionString>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IlcInvariantGlobalization>true</IlcInvariantGlobalization>
    <DebugType>full</DebugType>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2070;IL2075;IL3000</NoWarn>
  </PropertyGroup>

  <!-- 生成版本文件供 InnoSetup 读取 -->
  <Target Name="GenerateVersionFile" BeforeTargets="BeforeBuild" Outputs="Build\version.txt">
    <MakeDir Directories="Build" Condition="!Exists('Build')" />
    <WriteLinesToFile File="Build\version.txt" Lines="$(VersionString)" Overwrite="true" />
  </Target>

  <!-- 用 $(Version) 动态生成 app.manifest -->
  <Target Name="GenerateAppManifest" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_ManifestContent>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&#10;&lt;assembly manifestVersion=&quot;1.0&quot; xmlns=&quot;urn:schemas-microsoft-com:asm.v1&quot;&gt;&#10;  &lt;assemblyIdentity version=&quot;$(Version)&quot; name=&quot;GKME&quot;/&gt;&#10;  &lt;trustInfo xmlns=&quot;urn:schemas-microsoft-com:asm.v2&quot;&gt;&#10;    &lt;security&gt;&#10;      &lt;requestedPrivileges&gt;&#10;        &lt;requestedExecutionLevel level=&quot;requireAdministrator&quot; uiAccess=&quot;false&quot;/&gt;&#10;      &lt;/requestedPrivileges&gt;&#10;    &lt;/security&gt;&#10;  &lt;/trustInfo&gt;&#10;&lt;/assembly&gt;</_ManifestContent>
    </PropertyGroup>
    <WriteLinesToFile File="app.manifest" Lines="$(_ManifestContent)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="icon.ico" />
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="profiles\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>profiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <TrimmerRootDescriptor Include="linker.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="proto\gamepad_state.proto">
      <ProtoRoot>proto</ProtoRoot>
    </Protobuf>
  </ItemGroup>

  <!-- Driver source files are automatically included by SDK -->

  <!-- Build InputDll C++ project before C# compile -->
  <Target Name="BuildInputDll" BeforeTargets="BeforeBuild">
    <Message Text="Building InputDll..." Importance="high" />
    <Exec Command="&quot;C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe&quot; &quot;$(ProjectDir)Driver\InputDll\InputDll.vcxproj&quot; /p:Configuration=$(Configuration) /p:Platform=x64 /t:Build /nologo /v:normal" />
  </Target>

  <!-- Copy InputDll.dll to output directory -->
  <ItemGroup Condition="Exists('bin\$(Configuration)\InputDll.dll')">
    <Content Include="bin\$(Configuration)\InputDll.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>InputDll.dll</Link>
    </Content>
  </ItemGroup>

  <!-- Embedded resources: USBip installer + license notices -->
  <ItemGroup>
    <EmbeddedResource Include="Driver\Resources\USBip-0.9.7.7-x64.exe">
      <LogicalName>HIDMaestro.Resources.USBip-0.9.7.7-x64.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Driver\Resources\THIRD-PARTY-NOTICES.txt">
      <LogicalName>HIDMaestro.Resources.THIRD-PARTY-NOTICES.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Profile catalog as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="profiles\**\*.json" Exclude="profiles\schema.json;profiles\scraped_descriptors.json;profiles\linux-kernel-fixed-descriptors.json">
      <LogicalName>HIDMaestro.Profiles.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>