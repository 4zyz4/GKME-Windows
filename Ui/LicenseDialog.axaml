<Window x:Class="GKME.Ui.LicenseDialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About_GplTitle}"
        Width="720" Height="720"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#4A4A4A" />
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="*,Auto">
        <Border Grid.Row="0" Background="#252525" CornerRadius="4" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock x:Name="LicenseText" FontSize="12" Foreground="#B0B0B0"
                                     FontFamily="Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                     TextWrapping="Wrap" LineHeight="18" />
            </ScrollViewer>
        </Border>

        <Button Grid.Row="1" Content="{DynamicResource Close}" HorizontalAlignment="Right"
                Margin="0,12,0,0" Click="OnCloseClick" />
    </Grid>
</Window>
